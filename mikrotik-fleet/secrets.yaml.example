# Copy this to secrets.yaml, fill in real values, then encrypt in place:
#
#   cp secrets.yaml.example secrets.yaml
#   $EDITOR secrets.yaml     # replace every REPLACE_ME
#   sops --encrypt --in-place secrets.yaml
#
# After that, secrets.yaml has ENC[...] values and is safe to commit.
# This .example file stays plaintext in git on purpose -- it contains no
# real secrets, only the shape. See docs/secrets-setup.md.
#
# Keys here must match every {{SECRET:category:site}} token used in
# sites.yaml -- grep sites.yaml for "{{SECRET:" to get the current list.

secrets:
  wg_privkey:
    site-a: REPLACE_ME   # `wg genkey` output for site-a's router
    site-b: REPLACE_ME
  break_glass_password:
    site-a: REPLACE_ME   # unique long random password, never reused across sites
    site-b: REPLACE_ME
  snmp_community:
    site-a: REPLACE_ME   # random string, not "public"
    site-b: REPLACE_ME
